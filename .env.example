# Supabase Configuration
# For production/staging, fill these in from your Supabase dashboard.
# When absent, the application runs automatically in explicitly labelled "Local Demo Mode".
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional configuration
NEXT_PUBLIC_APP_NAME="NBS POS Training Platform"
NEXT_PUBLIC_BRAND_COLOR="#E4002B"
