# MariaDB / MySQL Database Configuration
# Fill these in matching your database credentials (supports Localhost or Managed Cloud DB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=ptp_user
DB_PASSWORD=YourStrongPassword123!
DB_NAME=nbs_pos_training
DB_SSL=false

# Session and Auth Configuration
# SESSION_TTL_DAYS defaults to 7 days if omitted
SESSION_TTL_DAYS=7
# COOKIE_SECURE: auto | true | false ('auto' activates Secure flag in production HTTPS)
COOKIE_SECURE=auto

# Application Branding
NEXT_PUBLIC_APP_NAME="NBS POS Training Platform"
NEXT_PUBLIC_BRAND_COLOR="#E4002B"
